<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <xacro:arg name="controllers_config" default=""/>

  <gazebo>
    <plugin filename="gz_ros2_control-system" name="gz_ros2_control::GazeboSimROS2ControlPlugin">
      <parameters>$(arg controllers_config)</parameters>
      <ros>
        <namespace>$(arg robot_namespace)</namespace>
      </ros>
    </plugin>
  </gazebo>

  <gazebo reference="camera_link">
    <sensor name="realsense_d435" type="rgbd_camera">
      <always_on>true</always_on>
      <update_rate>30</update_rate>
      <visualize>true</visualize>
      <topic>$(arg robot_namespace)/camera</topic>

      <camera>
        <horizontal_fov>1.204277</horizontal_fov>
        <image>
          <width>640</width>
          <height>480</height>
          <format>R8G8B8</format>
        </image>
        <clip>
          <near>0.10</near>
          <far>10.0</far>
        </clip>
      </camera>

      <depth_camera>
        <clip>
          <near>0.10</near>
          <far>10.0</far>
        </clip>
      </depth_camera>
    </sensor>
  </gazebo>

</robot>