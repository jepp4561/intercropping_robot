<?xml version="1.0"?>

<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="husky_soil_sampler">

<xacro:include filename="$(find soil_sampler_description)/urdf/soil_sampler_macro.urdf.xacro"/>

<xacro:soil_sampler
    parent_link="top_plate_front_mount"
    mount_xyz="0.15 0 0"
    mount_rpy="0 0 1.5708"/>

<ros2_control
    name="soil_sampler_hardware"
    type="system">

    <hardware>
        <plugin>gz_ros2_control/GazeboSimSystem</plugin>
    </hardware>

    <joint name="soil_sampler_slider_1">
        <command_interface name="position">
            <param name="min">0.0</param>
            <param name="max">0.2</param>
        </command_interface>
        <state_interface name="position"/>
        <state_interface name="velocity"/>
    </joint>

</ros2_control>

</robot>